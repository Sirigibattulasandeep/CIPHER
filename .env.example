# Required in production. Use the internal PostgreSQL URL provided by Render
# or an external managed PostgreSQL provider such as Neon or Supabase.
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
# Local embedded PostgreSQL port (default 5432).
# SENTRIX_DB_PORT=5432
SENTRIX_DATA_DIR="./data"

# Application port
PORT=3000

# Vercel only: public Render URL hosting the API and PostgreSQL-backed service.
# Leave blank when running the complete app on Render or locally.
# BACKEND_URL=https://sentrix-api.onrender.com

# Optional Google Gemini API key for AI summaries
GEMINI_API_KEY=

NODE_ENV=development

# Leave login values blank to create a local account and save its credentials to .env.local.
# SENTRIX_LOGIN_EMAIL=analyst@example.com
# SENTRIX_LOGIN_PASSWORD=change-this-password
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
