# Optional PostgreSQL. Uncomment and replace with your local credentials to enable Prisma persistence.
# DATABASE_URL="postgresql://user:password@localhost:5432/sentrix"
# Optional location for local JSON development data (brands, findings, investigations).
SENTRIX_DATA_DIR="./data"
SENTRIX_LOGIN_EMAIL=analyst@example.com
SENTRIX_LOGIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
