generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Industry {
  EDTECH
  FINTECH
  ECOMMERCE
  ENTERTAINMENT
  HEALTHCARE
  TECHNOLOGY_SAAS
  TRAVEL
  TELECOMMUNICATIONS
  CONSUMER_GOODS_FASHION
  GOVERNMENT_PUBLIC_SERVICES
}

enum Severity {
  CRITICAL
  HIGH
  MODERATE
  LOW
}

enum FindingStatus {
  NEW
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
}

enum MembershipRole {
  ADMIN
  ANALYST
  INVESTIGATOR
  READ_ONLY
}

model Organisation {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  brands      Brand[]
  memberships OrganizationMembership[]
  findings    Finding[]
  auditEvents AuditEvent[]
}

model User {
  id          String                   @id @default(cuid())
  email       String                   @unique
  createdAt   DateTime                 @default(now())
  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organisationId String
  userId         String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MembershipRole @default(ANALYST)
  createdAt      DateTime     @default(now())

  @@unique([organisationId, userId])
  @@index([organisationId, role])
}

model Brand {
  id                        String                   @id @default(cuid())
  organisationId            String
  organisation              Organisation             @relation(fields: [organisationId], references: [id])
  name                      String
  aliases                   Json
  description               String?
  logoUrl                   String?
  industry                  Industry
  subcategory               String?
  websiteUrl                String?
  domains                   Json
  socialProfiles            Json
  keywords                  Json
  impersonationIndicators   Json
  mobileApplications        Json
  officialAssets            OfficialAsset[]
  brandAliases              BrandAlias[]
  brandKeywords             BrandKeyword[]
  officialDomains           OfficialDomain[]
  officialSocialAccounts    OfficialSocialAccount[]
  officialMobileApplications OfficialMobileApplication[]
  monitoringConfiguration   MonitoringConfiguration?
  monitoringJobs            MonitoringJob[]
  findings                  Finding[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([organisationId, industry])
  @@unique([id, organisationId])
}

model OfficialAsset {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  type       String
  url        String
  label      String?
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([brandId, type, url])
  @@index([brandId, type])
}

model BrandAlias {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  value       String
  normalized  String
  createdAt   DateTime @default(now())

  @@unique([brandId, normalized])
}

model BrandKeyword {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  value       String
  normalized  String

  @@unique([brandId, normalized])
}

model OfficialDomain {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain      String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([brandId, domain])
  @@index([domain])
}

model OfficialSocialAccount {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform    String
  handle      String
  profileUrl  String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([brandId, profileUrl])
  @@index([platform, handle])
}

model OfficialMobileApplication {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  packageId   String
  storeUrl    String?
  publisher   String?
  createdAt   DateTime @default(now())

  @@unique([brandId, packageId])
  @@index([packageId])
}

model MonitoringConfiguration {
  id        String  @id @default(cuid())
  brandId   String  @unique
  brand     Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  enabled   Boolean @default(true)
  modules   Json
  rules     Json
  frequency String  @default("daily")
}

model MonitoringJob {
  id          String      @id @default(cuid())
  brandId     String
  brand       Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  status      String      @default("queued")
  startedAt   DateTime?
  completedAt DateTime?
  runs        MonitoringRun[]

  @@index([brandId, status, startedAt])
}

model MonitoringRun {
  id                String        @id @default(cuid())
  jobId             String
  job               MonitoringJob @relation(fields: [jobId], references: [id])
  sourceType        String
  sourceMode        String
  status            String
  recordsProcessed  Int           @default(0)
  recordsAccepted   Int           @default(0)
  recordsRejected   Int           @default(0)
  lastError         String?
  startedAt         DateTime      @default(now())
  completedAt       DateTime?

  @@index([jobId, startedAt])
}

model Finding {
  id                 String       @id @default(cuid())
  organisationId     String
  brandId            String
  entityKey          String
  organisation       Organisation @relation(fields: [organisationId], references: [id])
  brand              Brand        @relation(fields: [brandId, organisationId], references: [id, organisationId])
  category           String
  source             String
  affectedEntity     String
  title              String
  description        String
  sourceUrl          String?
  evidence           Json
  detectionIndicators Json
  riskScore          Int
  riskScoreBreakdown Json?
  scoringVersion     String?
  severity           Severity
  confidence         Int
  status             FindingStatus @default(NEW)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  evidences          Evidence[]
  investigations     Investigation[]
  riskAssessment     RiskAssessment?
  statusHistory      StatusHistory[]
  responseActions    ResponseAction[]
  feedback           FalsePositiveFeedback[]

  @@unique([id, organisationId])
  @@unique([organisationId, brandId, source, entityKey])
  @@index([organisationId, brandId, status, createdAt])
  @@index([organisationId, severity, status])
  @@index([organisationId, source, createdAt])
}

model Evidence {
  id             String   @id @default(cuid())
  findingId      String
  finding        Finding  @relation(fields: [findingId], references: [id])
  kind           String
  value          String
  sourceUrl      String?
  provenance     String   @default("automated")
  integrityHash  String?
  protectedRef   String?
  capturedAt     DateTime @default(now())

  @@index([findingId, capturedAt])
}

model RiskAssessment {
  id          String   @id @default(cuid())
  findingId   String   @unique
  finding     Finding  @relation(fields: [findingId], references: [id])
  score       Int
  rationale   String?
  version     String?
  createdAt   DateTime @default(now())
}

model Investigation {
  id          String              @id @default(cuid())
  findingId   String
  finding     Finding             @relation(fields: [findingId], references: [id])
  assigneeId  String?
  status      String              @default("open")
  notes       InvestigationNote[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([findingId])
  @@index([status, updatedAt])
}

model InvestigationNote {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id])
  authorId        String
  body            String
  createdAt       DateTime      @default(now())

  @@index([investigationId, createdAt])
}

model StatusHistory {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id])
  status    String
  changedBy String
  createdAt DateTime @default(now())

  @@index([findingId, createdAt])
}

model ResponseAction {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id])
  action    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model FalsePositiveFeedback {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id])
  reason    String
  createdAt DateTime @default(now())

  @@index([findingId, createdAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  action         String
  entityType     String
  entityId       String?
  metadata       Json
  createdAt      DateTime     @default(now())

  @@index([organisationId, createdAt])
}
